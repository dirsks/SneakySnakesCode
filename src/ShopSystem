import java.awt.*;
import java.awt.geom.*;
import java.awt.image.BufferedImage;
import java.util.*;

/**
 * ShopSystem — Loja com 3 abas: SKINS | ACCESSORY | FACES
 * Inclui suporte a TrailSystem na aba ACCESSORY (seção Trail).
 */
public class ShopSystem {

    // ── Abas ─────────────────────────────────────────────────────────────────
    private enum Tab { SKINS, ACCESSORY, FACES }
    private Tab currentTab = Tab.SKINS;

    // ── Layout ────────────────────────────────────────────────────────────────
    private static final int CARD_W   = 160;
    private static final int CARD_H   = 110;
    private static final int CARD_GAP = 16;
    private static final int COLS     = 4;
    private static final int START_X  = 24;
    private static final int START_Y  = 130; // abaixo das abas
    private static final int TAB_H    = 38;
    private static final int TAB_Y    = 70;

    private int scrollY    = 0;
    private int hoverIndex = -1;
    private Tab hoverTab   = null;

    // ─────────────────────────────────────────────────────────────────────────
    // PÚBLICO
    // ─────────────────────────────────────────────────────────────────────────

    public void draw(Graphics2D g, int W, int H, SaveSystem save, long tick) {
        // Fundo
        g.setColor(new Color(12, 15, 28));
        g.fillRect(0, 0, W, H);

        drawHeader(g, W, save);
        drawTabs(g, W);

        switch (currentTab) {
            case SKINS:     drawSkinsGrid    (g, W, H, save, tick); break;
            case ACCESSORY: drawAccessoryGrid(g, W, H, save, tick); break;
            case FACES:     drawFacesGrid    (g, W, H, save, tick); break;
        }

        // Dica de volta
        g.setFont(new Font("Arial", Font.PLAIN, 12));
        g.setColor(new Color(120, 160, 200, 160));
        g.drawString("ESC — Back to Menu", 16, H - 12);
    }

    /** Retorna true se comprou algo */
    public boolean handleClick(int mx, int my, SaveSystem save) {
        // Clique em aba
        Tab clicked = tabAt(mx, my);
        if (clicked != null) { currentTab = clicked; scrollY = 0; hoverIndex = -1; return false; }

        switch (currentTab) {
            case SKINS:     return handleSkinClick    (mx, my, save);
            case ACCESSORY: return handleAccessoryClick(mx, my, save);
            case FACES:     return handleFaceClick    (mx, my, save);
        }
        return false;
    }

    public void handleMouseMove(int mx, int my) {
        hoverTab   = tabAt(mx, my);
        hoverIndex = cardIndexAt(mx, my, itemCount());
    }

    public void scroll(int delta, int H) {
        scrollY = Math.max(0, scrollY + delta * 20);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DESENHO HEADER
    // ─────────────────────────────────────────────────────────────────────────

    private void drawHeader(Graphics2D g, int W, SaveSystem save) {
        g.setFont(new Font("Arial", Font.BOLD, 26));
        g.setColor(new Color(200, 220, 255));
        String title = "SHOP";
        FontMetrics fm = g.getFontMetrics();
        g.drawString(title, (W - fm.stringWidth(title)) / 2, 48);

        // Moedas
        g.setFont(new Font("Arial", Font.BOLD, 14));
        g.setColor(new Color(255, 215, 0));
        g.drawString("Coins: " + save.coins, W - 120, 28);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ABAS
    // ─────────────────────────────────────────────────────────────────────────

    private void drawTabs(Graphics2D g, int W) {
        Tab[] tabs = Tab.values();
        int totalW = tabs.length * 130 + (tabs.length - 1) * 8;
        int startX = (W - totalW) / 2;

        for (int i = 0; i < tabs.length; i++) {
            Tab t    = tabs[i];
            int tx   = startX + i * 138;
            boolean sel = (t == currentTab);
            boolean hov = (t == hoverTab && !sel);

            // Fundo da aba
            Color bg = sel ? new Color(60, 120, 220) : (hov ? new Color(40, 60, 100) : new Color(20, 28, 50));
            g.setColor(bg);
            g.fillRoundRect(tx, TAB_Y, 130, TAB_H, 10, 10);

            // Borda
            g.setColor(sel ? new Color(100, 180, 255) : new Color(50, 80, 140, 120));
            g.drawRoundRect(tx, TAB_Y, 130, TAB_H, 10, 10);

            // Label
            g.setFont(new Font("Arial", Font.BOLD, 14));
            g.setColor(sel ? Color.WHITE : new Color(160, 200, 255));
            FontMetrics fm = g.getFontMetrics();
            g.drawString(t.name(), tx + (130 - fm.stringWidth(t.name())) / 2, TAB_Y + TAB_H / 2 + 5);
        }
    }

    private Tab tabAt(int mx, int my) {
        Tab[] tabs = Tab.values();
        int totalW = tabs.length * 130 + (tabs.length - 1) * 8;
        int startX = (800 - totalW) / 2; // W hardcoded para simplificar
        for (int i = 0; i < tabs.length; i++) {
            int tx = startX + i * 138;
            if (mx >= tx && mx <= tx + 130 && my >= TAB_Y && my <= TAB_Y + TAB_H) return tabs[i];
        }
        return null;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ABA SKINS
    // ─────────────────────────────────────────────────────────────────────────

    private void drawSkinsGrid(Graphics2D g, int W, int H, SaveSystem save, long tick) {
        SkinSystem.Skin[] skins = SkinSystem.all();
        for (int i = 0; i < skins.length; i++) {
            SkinSystem.Skin skin = skins[i];
            int[] pos = cardPos(i);
            int cx = pos[0], cy = pos[1] - scrollY;
            if (cy + CARD_H < START_Y || cy > H) continue;

            boolean selected  = SkinSystem.current() == skin;
            boolean owned     = SkinSystem.isUnlocked(skin);
            boolean hovering  = (hoverIndex == i && currentTab == Tab.SKINS);
            boolean canBuy = !owned && save.coins >= skin.coinCost;

            drawCard(g, cx, cy, CARD_W, CARD_H, selected, hovering, owned, canBuy);

            // Preview da skin
            for (int s = 3; s >= 0; s--) {
                int px = cx + 14 + s * 10;
                SkinSystem.drawSegment(g, skin, px, cy + 16, 16, s == 0, tick, s);
            }

            // Nome
            g.setFont(new Font("Arial", Font.BOLD, 11));
            g.setColor(Color.WHITE);
            FontMetrics fm = g.getFontMetrics();
            g.drawString(skin.displayName, cx + (CARD_W - fm.stringWidth(skin.displayName)) / 2, cy + 52);

            // Preço / status
            drawCardStatus(g, cx, cy, CARD_W, CARD_H, owned, selected, skin.costLabel());
        }
    }

