    private boolean handleSkinClick(int mx, int my, SaveSystem save) {
        SkinSystem.Skin[] skins = SkinSystem.all();
        for (int i = 0; i < skins.length; i++) {
            SkinSystem.Skin skin = skins[i];
            int[] pos = cardPos(i);
            int cx = pos[0], cy = pos[1] - scrollY;
            
            // Verifica se o clique foi dentro do card
            if (!inCard(mx, my, cx, cy)) continue;

            // --- SUBSTITUA A LÓGICA ANTIGA POR ESTA ---
            if (SkinSystem.isUnlocked(skin)) { 
                SkinSystem.setById(skin.id); 
                return false; 
            }
            
            if (save.coins >= skin.coinCost && skin.coinCost > 0) {
                save.coins -= skin.coinCost;
                SkinSystem.unlock(skin); // Usa o novo método helper que criamos
                SkinSystem.setById(skin.id);
                return true;
            }
            // ------------------------------------------
        }
        return false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ABA ACCESSORY (Acessórios + Trilhas)
    // ─────────────────────────────────────────────────────────────────────────

    private void drawAccessoryGrid(Graphics2D g, int W, int H, SaveSystem save, long tick) {
        // Seção: Acessórios
        drawSectionLabel(g, START_X, START_Y - scrollY - 2, "Accessories");
        AccessorySystem.Accessory[] accs = AccessorySystem.Accessory.values();
        int accCols = COLS;
        for (int i = 0; i < accs.length; i++) {
            AccessorySystem.Accessory acc = accs[i];
            int[] pos = cardPos(i);
            int cx = pos[0], cy = pos[1] - scrollY;
            if (cy + CARD_H < START_Y || cy > H) continue;

            boolean selected = AccessorySystem.current() == acc;
            boolean owned    = AccessorySystem.isUnlocked(acc);
            boolean hov      = (hoverIndex == i && currentTab == Tab.ACCESSORY);
            boolean canBuy   = !owned && save.coins >= acc.coinCost;

            drawCard(g, cx, cy, CARD_W, CARD_H, selected, hov, owned, canBuy);

            // Preview: desenha acessório sobre uma cabeça fantasma
            drawAccessoryPreview(g, acc, cx + CARD_W / 2, cy + 36, 20, tick);

            g.setFont(new Font("Arial", Font.BOLD, 11));
            g.setColor(Color.WHITE);
            FontMetrics fm = g.getFontMetrics();
            g.drawString(acc.displayName, cx + (CARD_W - fm.stringWidth(acc.displayName)) / 2, cy + 62);
            drawCardStatus(g, cx, cy, CARD_W, CARD_H, owned, selected, acc.costLabel);
        }

        // Seção: Trilhas
        int trailOffsetY = ((accs.length + accCols - 1) / accCols) * (CARD_H + CARD_GAP) + 40;
        drawSectionLabel(g, START_X, START_Y + trailOffsetY - scrollY - 2, "Trails");
        TrailSystem.TrailType[] trails = TrailSystem.TrailType.values();
        for (int i = 0; i < trails.length; i++) {
            TrailSystem.TrailType trail = trails[i];
            int col = i % COLS, row = i / COLS;
            int cx = START_X + col * (CARD_W + CARD_GAP);
            int cy = START_Y + trailOffsetY + row * (CARD_H + CARD_GAP) - scrollY;
            if (cy + CARD_H < START_Y || cy > H) continue;

            boolean selected = TrailSystem.current() == trail;
            boolean owned    = TrailSystem.isUnlocked(trail);
            boolean hov      = (hoverIndex == accs.length + i && currentTab == Tab.ACCESSORY);
            boolean canBuy   = !owned && save.coins >= trail.coinCost;

            drawCard(g, cx, cy, CARD_W, CARD_H, selected, hov, owned, canBuy);

            // Preview: amostra animada da trilha
            drawTrailPreview(g, trail, cx, cy, CARD_W, tick);

            g.setFont(new Font("Arial", Font.BOLD, 11));
            g.setColor(Color.WHITE);
            FontMetrics fm = g.getFontMetrics();
            g.drawString(trail.displayName, cx + (CARD_W - fm.stringWidth(trail.displayName)) / 2, cy + 70);
            drawCardStatus(g, cx, cy, CARD_W, CARD_H, owned, selected, trail.costLabel);
        }
    }

    private boolean handleAccessoryClick(int mx, int my, SaveSystem save) {
        AccessorySystem.Accessory[] accs = AccessorySystem.Accessory.values();
        for (int i = 0; i < accs.length; i++) {
            AccessorySystem.Accessory acc = accs[i];
            int[] pos = cardPos(i);
            int cx = pos[0], cy = pos[1] - scrollY;
            if (!inCard(mx, my, cx, cy)) continue;
            if (AccessorySystem.isUnlocked(acc)) { AccessorySystem.set(acc); return false; }
            if (save.coins >= acc.coinCost && acc.coinCost > 0) {
                save.coins -= acc.coinCost; AccessorySystem.unlock(acc); AccessorySystem.set(acc); return true;
            }
        }
        // Trail section
        TrailSystem.TrailType[] trails = TrailSystem.TrailType.values();
        int trailOffsetY = ((accs.length + COLS - 1) / COLS) * (CARD_H + CARD_GAP) + 40;
        for (int i = 0; i < trails.length; i++) {
            TrailSystem.TrailType trail = trails[i];
            int col = i % COLS, row = i / COLS;
            int cx = START_X + col * (CARD_W + CARD_GAP);
            int cy = START_Y + trailOffsetY + row * (CARD_H + CARD_GAP) - scrollY;
            if (!inCard(mx, my, cx, cy)) continue;
            if (TrailSystem.isUnlocked(trail)) { TrailSystem.setType(trail); return false; }
            if (save.coins >= trail.coinCost && trail.coinCost > 0) {
                save.coins -= trail.coinCost; TrailSystem.unlock(trail); TrailSystem.setType(trail); return true;
            }
        }
        return false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ABA FACES
    // ─────────────────────────────────────────────────────────────────────────

    private void drawFacesGrid(Graphics2D g, int W, int H, SaveSystem save, long tick) {
        FaceSystem.Face[] faces = FaceSystem.Face.values();
        for (int i = 0; i < faces.length; i++) {
            FaceSystem.Face face = faces[i];
            int[] pos = cardPos(i);
            int cx = pos[0], cy = pos[1] - scrollY;
            if (cy + CARD_H < START_Y || cy > H) continue;

            boolean selected = FaceSystem.current() == face;
            boolean owned    = FaceSystem.isUnlocked(face);
            boolean hov      = (hoverIndex == i && currentTab == Tab.FACES);
            boolean canBuy   = !owned && save.coins >= face.coinCost;

            drawCard(g, cx, cy, CARD_W, CARD_H, selected, hov, owned, canBuy);

            // Preview: cabeça com o rosto
            drawFacePreview(g, face, cx + CARD_W / 2, cy + 36, 22, tick);

            g.setFont(new Font("Arial", Font.BOLD, 11));
            g.setColor(Color.WHITE);
            FontMetrics fm = g.getFontMetrics();
            g.drawString(face.displayName, cx + (CARD_W - fm.stringWidth(face.displayName)) / 2, cy + 66);
            drawCardStatus(g, cx, cy, CARD_W, CARD_H, owned, selected, face.costLabel);
        }
    }

    private boolean handleFaceClick(int mx, int my, SaveSystem save) {
        FaceSystem.Face[] faces = FaceSystem.Face.values();
        for (int i = 0; i < faces.length; i++) {
            FaceSystem.Face face = faces[i];
            int[] pos = cardPos(i);
            int cx = pos[0], cy = pos[1] - scrollY;
            if (!inCard(mx, my, cx, cy)) continue;
            if (FaceSystem.isUnlocked(face)) { FaceSystem.set(face); return false; }
            if (save.coins >= face.coinCost && face.coinCost > 0) {
                save.coins -= face.coinCost; FaceSystem.unlock(face); FaceSystem.set(face); return true;
            }
        }
        return false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PREVIEWS
    // ─────────────────────────────────────────────────────────────────────────

    private void drawAccessoryPreview(Graphics2D g, AccessorySystem.Accessory acc, int cx, int cy, int size, long tick) {
        // Cabeça fantasma cinza
        g.setColor(new Color(80, 100, 130));
        g.fillRoundRect(cx - size/2, cy - size/2, size, size, 5, 5);
        // Acessório
        AccessorySystem.draw(g, acc, cx - size/2, cy - size/2, size, 1, 0);
    }

    private void drawTrailPreview(Graphics2D g, TrailSystem.TrailType trail, int cx, int cy, int cardW, long tick) {
        // Animação simples: mostra ícone representativo
        int pcx = cx + cardW / 2, pcy = cy + 36;
        switch (trail) {
            case NONE:
                g.setColor(new Color(80, 80, 80));
                g.setFont(new Font("Arial", Font.BOLD, 11));
                g.drawString("—", pcx - 4, pcy + 4);
                break;
            case SPARKLE:
                drawPreviewSparkle(g, pcx, pcy, tick);
                break;
            case SMOKE:
                drawPreviewSmoke(g, pcx, pcy, tick);
                break;
            case HEARTS:
                drawPreviewHeart(g, pcx, pcy, tick);
                break;
            case STARS:
                drawPreviewStar(g, pcx, pcy, tick);
                break;
            case NEON:
                drawPreviewNeon(g, pcx, pcy, tick);
                break;
        }
    }

    private void drawPreviewSparkle(Graphics2D g, int cx, int cy, long tick) {
        for (int i = 0; i < 5; i++) {
            double a = tick * 0.05 + i * Math.PI * 2 / 5;
            int px = cx + (int)(Math.cos(a) * 10);
            int py = cy + (int)(Math.sin(a) * 10);
            float alpha = (float)(0.5 + Math.sin(tick * 0.1 + i) * 0.5);
            g.setColor(new Color(255, 220, 60, (int)(alpha * 200)));
            g.fillOval(px - 2, py - 2, 5, 5);
        }
    }

    private void drawPreviewSmoke(Graphics2D g, int cx, int cy, long tick) {
        for (int i = 0; i < 3; i++) {
            float a = (float)(0.3 - (tick * 0.01 + i * 0.3) % 0.8);
            int r = 4 + i * 3;
            int py = cy - (int)((tick * 0.3 + i * 8) % 22);
            g.setColor(new Color(160, 160, 160, Math.max(0, (int)(a * 200))));
            g.fillOval(cx - r, py - r, r * 2, r * 2);
        }
    }

    private void drawPreviewHeart(Graphics2D g, int cx, int cy, long tick) {
        float bob = (float)Math.sin(tick * 0.1) * 2;
        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.translate(cx, cy + bob);
        float s = 8f;
        GeneralPath heart = new GeneralPath();
        heart.moveTo(0, s * 0.3f);
        heart.curveTo(-s, -s*0.3f, -s*1.1f, s*0.7f, 0, s);
        heart.curveTo(s*1.1f, s*0.7f, s, -s*0.3f, 0, s*0.3f);
        g2.setColor(new Color(255, 80, 160));
        g2.fill(heart);
        g2.dispose();
    }

    private void drawPreviewStar(Graphics2D g, int cx, int cy, long tick) {
        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.translate(cx, cy);
        g2.rotate(tick * 0.03);
        Color[] cs = {new Color(255,100,100),new Color(100,200,255),new Color(255,220,60)};
        for (int i = 0; i < 3; i++) {
            double a = i * Math.PI * 2 / 3;
            int px = (int)(Math.cos(a) * 8);
            int py = (int)(Math.sin(a) * 8);
            g2.setColor(cs[i]);
            g2.fillOval(px - 3, py - 3, 7, 7);
        }
        g2.dispose();
    }

    private void drawPreviewNeon(Graphics2D g, int cx, int cy, long tick) {
        float r = 6 + (float)(Math.sin(tick * 0.08) * 2);
        Color[] neons = {new Color(80,200,255), new Color(200,80,255), new Color(80,255,160)};
        Color c = neons[(int)(tick / 20) % neons.length];
        g.setColor(new Color(c.getRed(), c.getGreen(), c.getBlue(), 60));
        g.setStroke(new BasicStroke(5f));
        g.drawOval((int)(cx - r - 2), (int)(cy - r - 2), (int)(r * 2 + 4), (int)(r * 2 + 4));
        g.setColor(c);
        g.setStroke(new BasicStroke(2f));
        g.drawOval((int)(cx - r), (int)(cy - r), (int)(r * 2), (int)(r * 2));
        g.setStroke(new BasicStroke(1f));
    }

    private void drawFacePreview(Graphics2D g, FaceSystem.Face face, int cx, int cy, int size, long tick) {
        // Cabeça fantasma
        g.setColor(new Color(60, 120, 80));
        g.fillRoundRect(cx - size/2, cy - size/2, size, size, 6, 6);
        FaceSystem.drawFace(g, face, cx - size/2, cy - size/2, size, 1, 0);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CARD HELPERS
    // ─────────────────────────────────────────────────────────────────────────

    private void drawCard(Graphics2D g, int cx, int cy, int w, int h,
                          boolean selected, boolean hov, boolean owned, boolean canBuy) {
        // Sombra
        g.setColor(new Color(0, 0, 0, 80));
        g.fillRoundRect(cx + 3, cy + 3, w, h, 12, 12);

        // Fundo
        Color bg = selected ? new Color(30, 70, 140)
                 : (hov ? new Color(25, 45, 80) : new Color(18, 24, 42));
        g.setColor(bg);
        g.fillRoundRect(cx, cy, w, h, 12, 12);

        // Borda
        Color border = selected ? new Color(80, 180, 255)
                     : (owned ? new Color(60, 180, 80, 160) : new Color(50, 70, 120, 120));
        g.setColor(border);
        g.drawRoundRect(cx, cy, w, h, 12, 12);

        // Brilho se pode comprar
        if (canBuy && !owned) {
            g.setColor(new Color(255, 215, 0, 20));
            g.fillRoundRect(cx, cy, w, h / 2, 12, 12);
        }
    }

    private void drawCardStatus(Graphics2D g, int cx, int cy, int w, int h,
                                boolean owned, boolean selected, String costLabel) {
        g.setFont(new Font("Arial", Font.PLAIN, 10));
        String label;
        Color  color;
        if (selected) { label = "✓ Equipped"; color = new Color(100, 220, 100); }
        else if (owned) { label = "Owned";     color = new Color(160, 200, 160); }
        else           { label = costLabel;    color = new Color(255, 215, 0); }
        FontMetrics fm = g.getFontMetrics();
        g.setColor(color);
        g.drawString(label, cx + (w - fm.stringWidth(label)) / 2, cy + h - 10);
    }

    private void drawSectionLabel(Graphics2D g, int x, int y, String label) {
        g.setFont(new Font("Arial", Font.BOLD, 13));
        g.setColor(new Color(140, 180, 255, 200));
        g.drawString("— " + label + " —", x, y + 14);
        g.setColor(new Color(60, 100, 180, 80));
        g.drawLine(x, y + 16, x + 760, y + 16);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LAYOUT HELPERS
    // ─────────────────────────────────────────────────────────────────────────

    private int[] cardPos(int i) {
        int col = i % COLS, row = i / COLS;
        return new int[]{
            START_X + col * (CARD_W + CARD_GAP),
            START_Y + row * (CARD_H + CARD_GAP)
        };
    }

    private boolean inCard(int mx, int my, int cx, int cy) {
        return mx >= cx && mx <= cx + CARD_W && my >= cy && my <= cy + CARD_H;
    }

    private int cardIndexAt(int mx, int my, int count) {
        for (int i = 0; i < count; i++) {
            int[] pos = cardPos(i);
            if (inCard(mx, my, pos[0], pos[1] - scrollY)) return i;
        }
        return -1;
    }

    private int itemCount() {
        switch (currentTab) {
            case SKINS:     return SkinSystem.all().length;
            case ACCESSORY: return AccessorySystem.Accessory.values().length + TrailSystem.TrailType.values().length;
            case FACES:     return FaceSystem.Face.values().length;
        }
        return 0;
    }
}